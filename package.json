{
  "name": "argv-flags",
  "version": "1.0.5",
  "description": "Schema-driven CLI flag parser with stable issue codes and machine-readable results.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/parse-result.schema.json": "./schema/parse-result.schema.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "examples:run": "node ./examples/run-all.mjs",
    "lint": "eslint .",
    "test": "npm run build && npm run lint && node --test",
    "test:runtimes": "node ./test/runtime-smoke.mjs && deno run ./test/runtime-smoke.mjs && bun ./test/runtime-smoke.mjs",
    "check": "node ./scripts/workflow-policy-check.mjs && npm run test && npm run docs:lint:jsr && npm run docs:test:jsr && npm run test:runtimes && npm run examples:run",
    "docs:lint:jsr": "deno doc --lint src/index.ts",
    "docs:test:jsr": "deno test --doc --no-check src/index.ts",
    "jsr:dry": "deno publish --dry-run --allow-dirty",
    "release:gate": "node ./scripts/release-gate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/argv-flags.git"
  },
  "keywords": [
    "argv",
    "cli",
    "flags",
    "parser"
  ],
  "author": "Ismail El Korchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/argv-flags/issues"
  },
  "homepage": "https://github.com/Ismail-elkorchi/argv-flags#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "typescript": "^6.0.3"
  }
}
