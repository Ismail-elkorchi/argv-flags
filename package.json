{
  "name": "argv-flags",
  "version": "4.0.0",
  "description": "Typed cross-runtime command-line option parser with structured diagnostics.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "BREAKING_CHANGES.md",
    "docs",
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "examples:run": "node ./examples/run-all.mjs",
    "lint": "eslint .",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test": "npm run build && npm run lint && npm run test:types && node --test",
    "test:consumers": "node ./scripts/packed-consumers.mjs",
    "check": "node ./scripts/workflow-policy-check.mjs && npm run test && npm run docs:lint:jsr && npm run docs:test:jsr && npm run test:consumers && npm run examples:run",
    "docs:lint:jsr": "deno doc --lint src/index.ts",
    "docs:test:jsr": "deno test --doc --no-check src/index.ts",
    "jsr:dry": "deno publish --dry-run --allow-dirty",
    "release:gate": "node ./scripts/release-gate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/argv-flags.git"
  },
  "keywords": [
    "argv",
    "cli",
    "command-line",
    "command-line-parser",
    "argument-parser",
    "option-parser",
    "flags",
    "options",
    "typescript",
    "esm",
    "node",
    "deno",
    "bun"
  ],
  "author": "Ismail El Korchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/argv-flags/issues"
  },
  "homepage": "https://github.com/Ismail-elkorchi/argv-flags#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "typescript": "^6.0.3"
  }
}
